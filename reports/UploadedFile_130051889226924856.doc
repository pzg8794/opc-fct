01x \u101x\u64259x\u99x\u105x\u101x\u110x\u116x \u111x\u114x\u103x\u97x\u110x\u105x\u122x\u97x\u116x\u105x\u111x\u110x \u119x\u104x\u105x\u99x\u104x \u105x\u115x \u119x\u104x\u121x \u97x \u108x\u111x\u116x \u111x\u102x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u97x\u116x\u116x\u101x\u109x\u112x\u116x\u115x \u119x\u101x\u114x\u101x \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u101x\u100x \u116x\u111x \u100x\u101x\u115x\u105x\u103x\u110x \u97x\u117x\u116x\u111x\u109x\u97x\u116x\u101x\u100x \u115x\u121x\u115x\u116x\u101x\u109x\u115x \u116x\u111x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u115x\u111x\u108x\u118x\u101x \u115x\u99x\u101x\u110x\u101x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u116x\u97x\u115x\u107x \u105x\u110x \u114x\u101x\u99x\u101x\u110x\u116x \u121x\u101x\u97x\u114x\u115x\u46x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u84x\u104x\u101x \u115x\u116x\u117x\u100x\u121x \u112x\u114x\u101x\u115x\u101x\u110x\u116x\u101x\u100x \u105x\u110x \u116x\u104x\u105x\u115x \u112x\u97x\u112x\u101x\u114x \u97x\u105x\u109x\u115x \u116x\u111x \u111x\u98x\u116x\u97x\u105x\u110x \u104x\u105x\u103x\u104x \u97x\u99x\u45x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u99x\u117x\u114x\u97x\u99x\u121x \u111x\u102x \u115x\u99x\u101x\u110x\u101x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u116x\u104x\u114x\u111x\u117x\u103x\u104x \u99x\u114x\u101x\u97x\u116x\u105x\u110x\u103x \u97x\u110x \u97x\u100x\u118x\u97x\u110x\u99x\u101x\u100x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x \u98x\u97x\u115x\u101x\u100x \u111x\u110x \u109x\u117x\u108x\u116x\u105x\u112x\u108x\u101x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u115x\u101x\u116x\u115x \u101x\u120x\u116x\u114x\u97x\u99x\u116x\u101x\u100x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u117x\u115x\u105x\u110x\u103x \u71x\u97x\u98x\u111x\u114x \u64257x\u108x\u116x\u101x\u114x\u115x\u44x \u67x\u69x\u78x\u84x\u82x\u73x\u83x\u84x \u97x\u110x\u100x \u99x\u111x\u108x\u111x\u114x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x\u115x\u46x \u84x\u104x\u101x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u103x\u111x\u97x\u108x \u105x\u115x \u116x\u111x \u112x\u114x\u111x\u100x\u117x\u99x\u101x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x\u115x \u116x\u104x\u97x\u116x \u100x\u101x\u115x\u99x\u114x\u105x\u98x\u101x \u116x\u104x\u101x \u115x\u99x\u101x\u110x\u101x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u97x\u115x \u97x\u99x\u99x\u117x\u114x\u97x\u116x\u101x\u108x\u121x \u97x\u115x \u112x\u111x\u115x\u115x\u105x\u98x\u108x\u101x\u46x \u69x\u97x\u99x\u104x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u101x\u120x\u116x\u114x\u97x\u99x\u116x\u105x\u111x\u110x \u109x\u101x\u116x\u104x\u111x\u100x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u105x\u115x \u64257x\u114x\u115x\u116x \u101x\u120x\u97x\u109x\u105x\u110x\u101x\u100x \u97x\u108x\u111x\u110x\u101x\u44x \u116x\u104x\u101x\u110x \u105x\u115x \u99x\u111x\u109x\u98x\u105x\u110x\u101x\u100x \u119x\u105x\u116x\u104x \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u111x\u98x\u116x\u97x\u105x\u110x\u101x\u100x \u119x\u105x\u116x\u104x \u111x\u116x\u104x\u101x\u114x \u109x\u101x\u116x\u104x\u111x\u100x\u115x \u97x\u110x\u100x \u116x\u101x\u115x\u116x\u101x\u100x \u111x\u110x \u97x\u99x\u99x\u117x\u114x\u97x\u99x\u121x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u105x\u109x\u112x\u114x\u111x\u118x\u101x\u109x\u101x\u110x\u116x\u46x \u84x\u104x\u105x\u115x \u112x\u97x\u112x\u101x\u114x \u115x\u104x\u111x\u119x\u115x \u116x\u104x\u101x \u104x\u105x\u103x\u104x \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u97x\u110x\u99x\u101x}\par {\b0\i0\strike0\f10\cf0\fs14\expnd0\expndtw0\kerning0 \u111x\u98x\u116x\u97x\u105x\u110x\u101x\u100x \u119x\u104x\u101x\u110x \u99x\u111x\u109x\u98x\u105x\u110x\u105x\u110x\u103x \u116x\u104x\u101x\u115x\u101x \u116x\u101x\u99x\u104x\u110x\u105x\u113x\u117x\u101x\u115x\u46x}\par }
