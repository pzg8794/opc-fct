{\pard\plain\posx6063\posy3438\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u91x\u49x\u93x \u74x\u46x \u68x\u97x\u117x\u103x\u109x\u97x\u110x\u44x \u8220x\u67x\u111x\u109x\u112x\u108x\u101x\u116x\u101x \u100x\u105x\u115x\u99x\u114x\u101x\u116x\u101x \u50x\u45x\u100x \u103x\u97x\u98x\u111x\u114x \u116x\u114x\u97x\u110x\u115x\u102x\u111x\u114x\u109x\u115x \u98x\u121x \u110x\u101x\u117x\u114x\u97x\u108x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0     \u110x\u101x\u116x\u119x\u111x\u114x\u107x\u115x \u102x\u111x\u114x \u105x\u109x\u97x\u103x\u101x \u97x\u110x\u97x\u108x\u121x\u115x\u105x\u115x \u97x\u110x\u100x \u99x\u111x\u109x\u112x\u114x\u101x\u115x\u115x\u105x\u111x\u110x\u44x\u8221x }{\b0\i0\strike0\f21\cf0\fs14\expnd0\expndtw0\kerning0 \u65x\u99x\u111x\u117x\u115x\u116x\u105x\u99x\u115x\u44x \u83x\u112x\u101x\u101x\u99x\u104x}\par {\b0\i0\strike0\f21\cf0\fs14\expnd0\expndtw0\kerning0     \u97x\u110x\u100x \u83x\u105x\u103x\u110x\u97x\u108x \u80x\u114x\u111x\u99x\u101x\u115x\u115x\u105x\u110x\u103x\u44x \u73x\u69x\u69x\u69x \u84x\u114x\u97x\u110x\u115x\u97x\u99x\u116x\u105x\u111x\u110x\u115x \u111x\u110x\u44x }{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u118x\u111x\u108x\u46x \u51x\u54x\u44x \u110x\u111x\u46x \u55x\u44x \u112x\u112x\u46x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0     \u49x\u49x\u54x\u57x\u8211x\u49x\u49x\u55x\u57x\u44x \u49x\u57x\u56x\u56x\u46x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u91x\u50x\u93x \u68x\u46x \u68x\u117x\u110x\u110x\u44x \u87x\u46x\u69x\u46x \u72x\u105x\u103x\u103x\u105x\u110x\u115x\u44x \u74x\u46x \u87x\u97x\u107x\u101x\u108x\u101x\u121x\u44x \u8220x\u84x\u101x\u120x\u116x\u117x\u114x\u101x \u115x\u101x\u103x\u109x\u101x\u110x\u116x\u97x\u116x\u105x\u111x\u110x \u117x\u115x\u105x\u110x\u103x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0     \u50x\u45x\u100x \u103x\u97x\u98x\u111x\u114x \u101x\u1