0\kerning0    \u84x\u104x\u101x \u112x\u117x\u114x\u112x\u111x\u115x\u101x \u111x\u102x \u119x\u104x\u105x\u116x\u101x\u110x\u105x\u110x\u103x \u105x\u115x \u114x\u101x\u109x\u111x\u118x\u105x\u110x\u103x \u112x\u97x\u105x\u114x\u119x\u105x\u115x\u101x\u44x \u108x\u105x\u110x\u101x\u97x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u111x\u114x\u114x\u101x\u108x\u97x\u116x\u105x\u111x\u110x\u115x\u44x \u97x\u110x\u100x \u116x\u104x\u117x\u115x \u114x\u101x\u109x\u111x\u118x\u101x \u110x\u111x\u105x\u115x\u101x \u97x\u110x\u100x \u8221x\u115x\u105x\u109x\u112x\u108x\u105x\u102x\u121x\u8221x \u97x\u110x \u105x\u109x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u97x\u103x\u101x\u46x \u87x\u104x\u105x\u116x\u101x\u110x\u105x\u110x\u103x \u99x\u97x\u110x \u98x\u101x \u100x\u111x\u110x\u101x \u116x\u104x\u114x\u111x\u117x\u103x\u104x \u100x\u101x\u115x\u105x\u103x\u110x\u105x\u110x\u103x \u97x \u64257x\u108x\u116x\u101x\u114x \u105x\u110x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u101x \u102x\u114x\u101x\u113x\u117x\u101x\u110x\u99x\u121x \u100x\u111x\u109x\u97x\u105x\u110x \u116x\u104x\u97x\u116x \u119x\u105x\u108x\u108x \u64258x\u97x\u116x\u116x\u101x\u110x \u116x\u104x\u101x \u115x\u112x\u101x\u99x\u116x\u114x\u117x\u109x \u111x\u102x \u97x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u110x\u97x\u116x\u117x\u114x\u97x\u108x \u105x\u109x\u97x\u103x\u101x\u46x \u65x\u109x\u112x\u108x\u105x\u116x\u117x\u100x\u101x \u115x\u112x\u101x\u99x\u116x\u114x\u117x\u109x \u111x\u102x \u115x\u117x\u99x\u104x \u64257x\u108x\u116x\u101x\u114x \u104x\u97x\u115x \u116x\u111x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u114x\u105x\u115x\u101x \u108x\u105x\u110x\u101x\u97x\u114x\u108x\u121x \u119x\u105x\u116x\u104x \u102x\u114x\u101x\u113x\u117x\u101x\u110x\u99x\u121x\u44x \u116x\u111x \u99x\u111x\u109x\u112x\u101x\u110x\u115x\u97x\u116x\u101x \u102x\u111x\u114x \u116x\u104x\u101x \u97x\u109x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u112x\u108x\u105x\u116x\u117x\u100x\u101x \u115x\u112x\u101x\u99x\u116x\u114x\u117x\u109x \u111x\u102x \u110x\u97x\u116x\u117x\u114x\u97x\u108x \u105x\u109x\u97x\u103x\u101x\u115x\u46x \u84x\u104x\u105x\u115x \u99x\u97x\u110x \u98x\u101x \u100x\u111x\u110x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u114x\u111x\u117x\u103x\u104x \u100x\u101x\u64257x\u110x\u105x\u110x\u103x \u97x \u103x\u114x\u105x\u100x \u111x\u102x \u102x\u114x\u101x\u113x\u117x\u101x\u110x\u99x\u121x \u99x\u111x\u111x\u114x\u100x\u105x\u110x\u97x\u116x\u101x\u115x\u46x \u66x\u101x\u99x\u97x\u117x\u115x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u111x\u110x\u118x\u111x\u108x\u117x\u116x\u105x\u111x\u110x \u105x\u110x \u116x\u104x\u101x \u115x\u112x\u97x\u99x\u101x \u100x\u111x\u109x\u97x\u105x\u110x \u105x\u115x \u101x\u113x\u117x\u105x\u118x\u97x\u108x\u101x\u110x\u116x \u116x\u111x \u109x\u117x\u108x\u116x\u105x\u112x\u108x\u105x\u99x\u97x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u105x\u111x\u110x \u105x\u110x \u116x\u104x\u101x \u102x\u114x\u101x\u113x\u117x\u101x\u110x\u99x\u121x \u100x\u111x\u109x\u97x\u105x\u110x\u44x \u119x\u104x\u105x\u116x\u101x\u110x\u105x\u110x\u103x \u99x\u97x\u110x \u98x\u101x \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u101x\u100x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u114x\u111x\u117x\u103x\u104x \u109x\u117x\u108x\u116x\u105x\u112x\u108x\u121x\u105x\u110x\u103x \u116x\u104x\u101x \u115x\u112x\u101x\u99x\u116x\u114x\u117x\u109x \u111x\u102x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x \u119x\u105x\u116x\u104x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u115x\u112x\u101x\u99x\u116x\u114x\u117x\u109x \u111x\u102x \u116x\u104x\u101x \u64257x\u108x\u116x\u101x\u114x \u97x\u110x\u100x \u116x\u97x\u107x\u105x\u110x\u103x \u116x\u104x\u101x \u105x\u110x\u118x\u101x\u114x\u115x\u101x \u70x\u97x\u115x\u116x \u70x\u111x\u117x\u114x\u105x\u101x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u84x\u114x\u97x\u110x\u115x\u102x\u111x\u114x\u109x \u111x\u102x \u116x\u104x\u101x \u64257x\u108x\u116x\u101x\u114x\u101x\u100x \u105x\u109x\u97x\u103x\u101x \u40x\u115x\u101x\u101x \u64257x\u103x\u117x\u114x\u101x \u51x\u46x\u98x\u41x\u46x \u67x\u111x\u110x\u116x\u114x\u97x\u115x\u116x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u110x\u111x\u114x\u109x\u97x\u108x\u105x\u122x\u97x\u116x\u105x\u111x\u110x \u105x\u115x \u116x\u104x\u101x \u115x\u116x\u97x\u110x\u100x\u97x\u114x\u100x \u111x\u112x\u101x\u114x\u97x\u116x\u105x\u111x\u110x \u116x\u111x \u98x\u101x \u100x\u111x\u110x\u101x \u97x\u102x\u116x\u101x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u119x\u104x\u105x\u116x\u101x\u110x\u105x\u110x\u103x\u46x \u70x\u111x\u114x \u116x\u104x\u105x\u115x \u112x\u114x\u111x\u106x\u101x\u99x\u116x\u44x \u110x\u111x\u114x\u109x\u97x\u108x\u105x\u122x\u97x\u116x\u105x\u111x\u110x \u119x\u97x\u115x \u100x\u111x\u110x\u101x \u98x\u121x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u100x\u105x\u118x\u105x\u100x\u105x\u110x\u103x \u116x\u104x\u101x \u111x\u117x\u116x\u112x\u117x\u116x \u111x\u102x \u116x\u104x\u101x \u119x\u104x\u105x\u116x\u101x\u110x\u105x\u110x\u103x \u115x\u116x\u101x\u112x \u98x\u121x \u116x\u104x\u101x \u108x\u111x\u99x\u97x\u108x \u108x\u117x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u109x\u105x\u110x\u97x\u110x\u99x\u101x \u118x\u97x\u114x\u105x\u97x\u110x\u99x\u101x \u91x\u51x\u93x \u91x\u52x\u93x\u46x}\par }
{\pard\plain\posx934\posy13835\absw3141\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u52x\u46x\u50x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u71x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u70x\u101x\u97x\u116x\u117x\u114x\u101x \u69x\u120x\u116x\u114x\u97x\u99x\u116x\u105x\u111x\u110x}\par }
{\pard\plain\posx934\posy14149\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0   \u73x\u110x \u116x\u104x\u101x \u115x\u99x\u111x\u112x\u101x \u111x\u102x \u116x\u104x\u105x\u115x \u112x\u114x\u111x\u106x\u101x\u99x\u116x\u44x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u71x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u100x\u105x\u109x\u101x\u110x\u115x\u105x\u111x\u110x\u97x\u108x\u105x\u116x\u121x \u119x\u97x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u114x\u101x\u100x\u117x\u99x\u101x\u100x \u117x\u115x\u105x\u110x\u103x \u97x\u110x \u97x\u118x\u101x\u114x\u97x\u103x\u105x\u110x\u103x \u111x\u118x\u101x\u114x \u110x\u111x\u110x\u45x\u111x\u118x\u101x\u114x\u108x\u97x\u112x\u112x\u105x\u110x\u103x \u115x\u113x\u117x\u97x\u114x\u101x}\par }
{\pard\plain\posx6063\posy7327\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u70x\u105x\u103x\u46x \u52x\u46x \u97x\u41x \u67x\u111x\u110x\u116x\u114x\u117x\u115x\u116x \u78x\u111x\u114x\u109x\u97x\u108x\u105x\u122x\u101x\u100x \u73x\u109x\u97x\u103x\u101x \u97x\u110x\u100x \u98x\u41x \u71x\u97x\u98x\u111x\u114x \u71x\u73x\u83x\u84x \u118x\u105x\u115x\u117x\u97x\u108x\u45x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u105x\u122x\u97x\u116x\u105x\u111x\u110x}\par }
{\pard\plain\posx6063\posy8078\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u109x\u97x\u103x\u101x \u98x\u108x\u111x\u99x\u107x\u115x \u40x\u102x\u111x\u114x \u116x\u104x\u105x\u115x \u112x\u114x\u111x\u106x\u101x\u99x\u116x\u44x \u64257x\u120x\u101x\u100x \u52x\u120x\u52x \u103x\u114x\u105x\u100x \u111x\u102x \u115x\u117x\u98x\u45x\u114x\u101x\u103x\u105x\u111x\u110x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u111x\u118x\u101x\u114x \u116x\u104x\u101x \u109x\u97x\u112x \u119x\u97x\u115x \u99x\u111x\u110x\u115x\u105x\u100x\u101x\u114x\u101x\u100x\u41x \u91x\u53x\u93x\u46x \u84x\u104x\u117x\u115x\u44x \u116x\u104x\u101x \u115x\u105x\u122x\u101x \u111x\u102x \u102x\u101x\u97x\u116x\u117x\u114x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u118x\u101x\u99x\u116x\u111x\u114x \u105x\u115x \u49x\u120x\u53x\u55x\u54x\u58x \u52x\u120x\u52x \u103x\u114x\u105x\u100x \u40x\u49x\u54x \u119x\u105x\u110x\u100x\u111x\u119x\u115x \u119x\u104x\u101x\u114x\u101x \u97x\u118x\u101x\u114x\u97x\u103x\u101x \u118x\u97x\u108x\u117x\u101x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u115x \u99x\u111x\u109x\u112x\u117x\u116x\u101x\u100x\u41x \u120x \u49x\u50x \u40x\u64257x\u108x\u116x\u101x\u114x\u115x \u105x\u110x \u116x\u104x\u101x \u71x\u97x\u98x\u111x\u114x \u98x\u97x\u110x\u107x\u41x \u120x \u51x \u40x\u110x\u117x\u109x\u98x\u101x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u111x\u102x \u99x\u111x\u108x\u111x\u114x \u112x\u108x\u97x\u110x\u101x\u115x \u102x\u111x\u114x \u82x\u71x\u66x \u105x\u109x\u97x\u103x\u101x\u41x\u46x}\par }
