{\pard\plain\posx6063\posy6211\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u84x\u104x\u101x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u77x\u97x\u116x\u108x\u97x\u98x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u117x\u110x\u99x\u116x\u105x\u111x\u110x }{\b0\i0\strike0\f19\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u84x\u102x\u101x\u97x\u116x\u117x\u114x\u101x\u86x\u101x\u99x\u116x\u111x\u114x\u46x\u109x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u114x\u101x\u97x\u116x\u101x\u115x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u111x\u114x \u97x\u108x\u108x \u116x\u114x\u97x\u105x\u110x\u105x\u110x\u103x \u97x\u110x\u100x \u116x\u101x\u115x\u116x\u105x\u110x\u103x \u105x\u109x\u97x\u103x\u101x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u97x\u110x\u100x \u115x\u97x\u118x\u101x\u115x \u100x\u97x\u116x\u97x \u105x\u110x \u97x }{\b0\i0\strike0\f19\cf0\fs17\expnd0\expndtw0\kerning0 \u46x\u109x\u97x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u64257x\u108x\u101x\u46x \u73x\u110x \u111x\u114x\u100x\u101x\u114x \u116x\u111x \u111x\u98x\u116x\u97x\u105x\u110x \u116x\u104x\u101x \u98x\u101x\u115x\u116x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u97x\u110x\u99x\u101x\u44x \u100x\u105x\u64256x\u101x\u114x\u101x\u110x\u116x \u112x\u97x\u114x\u97x\u109x\u101x\u116x\u101x\u114x\u115x \u104x\u97x\u118x\u101x \u116x\u111x \u98x\u101x \u116x\u101x\u115x\u116x\u101x\u100x\u46x \u84x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u111x\u108x\u108x\u111x\u119x\u105x\u110x\u103x \u112x\u97x\u114x\u97x\u109x\u101x\u116x\u101x\u114x\u115x \u104x\u97x\u118x\u101x \u98x\u101x\u101x\u110x \u117x\u115x\u101x\u100x \u102x\u111x\u114x \u116x\u104x\u101x \u114x\u101x\u115x\u116x \u111x\u102x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u112x\u114x\u111x\u106x\u101x\u99x\u116x \u115x\u105x\u110x\u99x\u101x \u116x\u104x\u101x\u121x \u112x\u114x\u111x\u100x\u117x\u99x\u101x\u100x \u116x\u104x\u101x \u115x\u109x\u97x\u108x\u108x\u101x\u115x\u116x \u109x\u105x\u115x\u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u114x\u97x\u116x\u101x\u58x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    }{\b0\i0\strike0\f13\cf0\fs12\expnd0\expndtw0\kerning0 \u8226x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u68x\u111x\u119x\u110x\u115x\u105x\u122x\u105x\u110x\u103x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x \u116x\u111x \u97x \u114x\u97x\u116x\u105x\u111x \u111x\u102x \u48x\u46x\u49x\u50x\u53x\u46x \u84x\u104x\u105x\u115x \u114x\u101x\u100x\u117x\u99x\u101x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u104x\u101x \u99x\u111x\u109x\u112x\u117x\u116x\u97x\u116x\u105x\u111x\u110x \u116x\u105x\u109x\u101x \u97x\u110x\u100x \u107x\u101x\u101x\u112x\u115x \u116x\u104x\u101x \u114x\u101x\u108x\u101x\u118x\u97x\u110x\u116x \u105x\u110x\u102x\u111x\u114x\u109x\u97x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u105x\u111x\u110x \u111x\u102x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    }{\b0\i0\strike0\f13\cf0\fs12\expnd0\expndtw0\kerning0 \u8226x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u68x\u105x\u118x\u105x\u100x\u105x\u110x\u103x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x \u105x\u110x\u116x\u111x \u52x \u108x\u105x\u110x\u101x\u115x \u115x\u101x\u101x\u109x\u101x\u100x \u116x\u111x \u98x\u101x \u116x\u104x\u101x \u109x\u111x\u115x\u116x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u101x\u64259x\u99x\u105x\u101x\u110x\u116x\u58x \u105x\u110x\u115x\u116x\u101x\u97x\u100x \u111x\u102x \u99x\u111x\u110x\u115x\u105x\u100x\u101x\u114x\u105x\u110x\u103x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x \u97x\u115x \u97x \u119x\u104x\u111x\u108x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u101x\u110x\u116x\u105x\u116x\u121x\u44x \u105x\u116x \u105x\u115x \u100x\u105x\u118x\u105x\u100x\u101x\u100x \u105x\u110x\u116x\u111x \u52x \u108x\u105x\u110x\u101x\u115x\u46x \u84x\u104x\u101x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u118x\u101x\u99x\u116x\u111x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u105x\u115x \u99x\u111x\u109x\u112x\u117x\u116x\u101x\u100x \u102x\u111x\u114x \u101x\u97x\u99x\u104x \u108x\u105x\u110x\u101x \u97x\u110x\u100x \u116x\u104x\u101x \u52x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u118x\u101x\u99x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u111x\u114x\u115x \u97x\u114x\u101x \u99x\u111x\u110x\u99x\u97x\u116x\u101x\u110x\u97x\u116x\u101x\u100x \u116x\u111x \u111x\u98x\u116x\u97x\u105x\u110x \u116x\u104x\u101x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u118x\u101x\u99x\u116x\u111x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u111x\u102x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x\u46x \u84x\u104x\u105x\u115x \u101x\u110x\u97x\u98x\u108x\u101x \u116x\u111x \u107x\u101x\u101x\u112x \u115x\u111x\u109x\u101x \u111x\u102x \u116x\u104x\u101x \u115x\u112x\u97x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u105x\u97x\u108x \u105x\u110x\u102x\u111x\u114x\u109x\u97x\u116x\u105x\u111x\u110x \u105x\u110x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x \u116x\u104x\u97x\u116x \u99x\u97x\u110x \u104x\u101x\u108x\u112x \u99x\u108x\u97x\u115x\u115x\u105x\u102x\u121x\u105x\u110x\u103x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u115x\u99x\u101x\u110x\u101x\u115x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    }{\b0\i0\strike0\f13\cf0\fs12\expnd0\expndtw0\kerning0 \u8226x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u72x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u73x\u110x\u116x\u101x\u114x\u115x\u101x\u99x\u116x\u105x\u111x\u110x \u77x\u101x\u116x\u104x\u111x\u100x\u46x \u73x\u110x \u111x\u114x\u100x\u101x\u114x \u116x\u111x \u99x\u111x\u109x\u112x\u97x\u114x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u104x\u101x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x \u111x\u102x \u97x \u116x\u101x\u115x\u116x\u101x\u100x \u105x\u109x\u97x\u103x\u101x \u116x\u111x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u109x\u101x\u97x\u110x \u111x\u102x \u116x\u104x\u101x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u118x\u101x\u99x\u116x\u111x\u114x\u115x \u111x\u102x \u105x\u109x\u97x\u103x\u101x\u115x \u98x\u101x\u108x\u111x\u110x\u103x\u105x\u110x\u103x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u111x \u97x \u103x\u105x\u118x\u101x\u110x \u99x\u108x\u97x\u115x\u115x\u44x \u116x\u104x\u101x \u109x\u101x\u97x\u115x\u117x\u114x\u101x \u111x\u102x \u100x\u105x\u64256x\u101x\u114x\u101x\u110x\u99x\u101x \u109x\u117x\u115x\u116x \u98x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u99x\u97x\u108x\u99x\u117x\u108x\u97x\u116x\u101x\u100x\u46x \u84x\u104x\u105x\u115x \u99x\u97x\u110x \u98x\u101x \u100x\u111x\u110x\u101x \u117x\u115x\u105x\u110x\u103x \u116x\u104x\u101x \u69x\u117x\u99x\u108x\u105x\u100x\u105x\u97x\u110x \u100x\u105x\u115x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u97x\u110x\u99x\u101x \u111x\u114x \u116x\u104x\u101x \u72x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u73x\u110x\u116x\u101x\u114x\u115x\u101x\u99x\u116x\u105x\u111x\u110x \u77x\u101x\u116x\u104x\u111x\u100x\u46x \u84x\u104x\u101x \u72x\u105x\u115x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u116x\u111x\u103x\u114x\u97x\u109x \u73x\u110x\u116x\u101x\u114x\u115x\u101x\u99x\u116x\u105x\u111x\u110x \u77x\u101x\u116x\u104x\u111x\u100x \u103x\u101x\u110x\u101x\u114x\u97x\u116x\u101x\u100x \u109x\u117x\u99x\u104x \u98x\u101x\u116x\u116x\u101x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u116x\u104x\u97x\u110x \u119x\u104x\u101x\u110x \u117x\u115x\u105x\u110x\u103x \u116x\u104x\u101x \u69x\u117x\u99x\u108x\u105x\u100x\u105x\u97x\u110x \u100x\u105x\u115x\u116x\u97x\u110x\u99x\u101x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    }{\b0\i0\strike0\f13\cf0\fs12\expnd0\expndtw0\kerning0 \u8226x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u52x\u48x \u98x\u105x\u110x\u115x \u97x\u114x\u101x \u117x\u115x\u101x\u100x \u102x\u111x\u114x \u116x\u104x\u101x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x\u115x\u46x \u84x\u104x\u105x\u115x \u105x\u115x \u116x\u104x\u101x \u98x\u101x\u115x\u116x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u99x\u111x\u109x\u112x\u114x\u111x\u109x\u105x\u115x\u101x \u98x\u101x\u116x\u119x\u101x\u101x\u110x \u116x\u104x\u101x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u114x\u97x\u116x\u101x\u44x \u116x\u104x\u101x \u99x\u111x\u109x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0      \u112x\u117x\u116x\u97x\u116x\u105x\u111x\u110x \u116x\u105x\u109x\u101x \u97x\u110x\u100x \u116x\u104x\u101x \u115x\u105x\u122x\u101x \u111x\u102x \u116x\u104x\u101x \u103x\u101x\u110x\u101x\u114x\u97x\u116x\u101x\u100x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x}\par {\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0      }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x\u46x}\par }
