{\pard\plain\posx6063\posy8654\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u84x\u104x\u101x \u105x\u100x\u101x\u97x \u111x\u102x \u116x\u104x\u105x\u115x \u109x\u101x\u116x\u104x\u111x\u100x \u105x\u115x \u116x\u111x \u99x\u97x\u108x\u99x\u117x\u108x\u97x\u116x\u101x \u105x\u110x\u116x\u101x\u110x\u115x\u105x\u116x\u121x \u104x\u105x\u115x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u111x\u103x\u114x\u97x\u109x \u102x\u111x\u114x \u71x\u97x\u98x\u111x\u114x \u64257x\u108x\u116x\u101x\u114x\u101x\u100x \u105x\u109x\u97x\u103x\u101x\u115x\u46x \u65x \u99x\u111x\u108x\u111x\u114x \u105x\u109x\u97x\u103x\u101x \u99x\u111x\u110x\u118x\u101x\u114x\u116x\u101x\u100x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u110x\u116x\u111x \u103x\u114x\u97x\u121x\u115x\u99x\u97x\u108x\u101x \u119x\u97x\u115x \u115x\u112x\u108x\u105x\u116x \u105x\u110x\u116x\u111x \u102x\u111x\u117x\u114x \u104x\u111x\u114x\u105x\u122x\u111x\u110x\u116x\u97x\u108x \u112x\u105x\u101x\u99x\u101x\u115x \u105x\u110x \u111x\u114x\u100x\u101x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u111x \u112x\u114x\u101x\u115x\u101x\u114x\u118x\u101x \u115x\u111x\u109x\u101x \u115x\u112x\u97x\u116x\u105x\u97x\u108x \u105x\u110x\u102x\u111x\u114x\u109x\u97x\u116x\u105x\u111x\u110x \u97x\u110x\u100x \u112x\u111x\u116x\u101x\u110x\u116x\u105x\u97x\u108x\u108x\u121x \u105x\u110x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u114x\u101x\u97x\u115x\u101x \u116x\u104x\u101x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u97x\u99x\u99x\u117x\u114x\u97x\u99x\u121x\u46x \u69x\u97x\u99x\u104x \u113x\u117x\u97x\u114x\u116x\u101x\u114x \u111x\u102x \u97x\u110x \u105x\u109x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u97x\u103x\u101x \u105x\u110x \u116x\u104x\u101x \u116x\u114x\u97x\u105x\u110x\u105x\u110x\u103x \u97x\u110x\u100x \u116x\u101x\u115x\u116x\u105x\u110x\u103x \u115x\u101x\u116x\u115x \u119x\u97x\u115x \u99x\u111x\u110x\u118x\u111x\u108x\u118x\u101x\u100x \u119x\u105x\u116x\u104x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u64257x\u108x\u116x\u101x\u114x \u98x\u97x\u110x\u107x\u46x \u73x\u110x\u116x\u101x\u110x\u115x\u105x\u116x\u121x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u119x\u97x\u115x \u99x\u97x\u108x\u99x\u117x\u108x\u97x\u116x\u101x\u100x \u102x\u114x\u111x\u109x \u101x\u97x\u99x\u104x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u112x\u105x\u101x\u99x\u101x \u111x\u102x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x \u40x\u51x\u50x \u98x\u105x\u110x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x\u115x \u115x\u104x\u111x\u119x\u101x\u100x \u115x\u105x\u109x\u105x\u108x\u97x\u114x \u97x\u99x\u99x\u117x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u114x\u97x\u99x\u121x \u116x\u111x \u54x\u52x \u98x\u105x\u110x\u115x\u41x\u46x \u84x\u104x\u117x\u115x\u44x \u116x\u104x\u101x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x \u100x\u105x\u109x\u101x\u110x\u115x\u105x\u111x\u110x\u97x\u108x\u105x\u116x\u121x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u115x \u49x\u120x\u49x\u50x\u56x\u46x \u84x\u101x\u115x\u116x\u105x\u110x\u103x \u119x\u97x\u115x \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u101x\u100x \u105x\u110x \u116x\u119x\u111x \u119x\u97x\u121x\u115x\u58x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    }{\b0\i0\strike0\f13\cf0\fs12\expnd0\expndtw0\kerning0 \u8226x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u97x\u108x\u99x\u117x\u108x\u97x\u116x\u105x\u110x\u103x \u97x\u118x\u101x\u114x\u97x\u103x\u101x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u102x\u111x\u114x \u101x\u97x\u99x\u104x \u99x\u108x\u97x\u115x\u115x \u102x\u114x\u111x\u109x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\exp