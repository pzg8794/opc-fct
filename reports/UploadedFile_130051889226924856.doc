{\pard\plain\posx934\posy6153\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u40x\u64257x\u103x\u117x\u114x\u101x \u53x\u41x \u97x\u110x\u100x \u102x\u111x\u114x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u40x\u64257x\u103x\u117x\u114x\u101x \u56x\u41x \u97x\u114x\u101x \u98x\u111x\u116x\u104x \u49x\u52x\u37x\u44x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u109x\u105x\u115x\u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u114x\u97x\u116x\u101x\u115x \u118x\u97x\u114x\u121x \u102x\u111x\u114x \u101x\u97x\u99x\u104x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u121x\u46x \u84x\u104x\u105x\u115x \u109x\u101x\u97x\u110x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u97x\u116x \u116x\u104x\u101x \u109x\u101x\u116x\u104x\u111x\u100x \u117x\u115x\u101x\u100x \u119x\u105x\u108x\u108x \u97x\u64256x\u101x\u99x\u116x \u101x\u97x\u99x\u104x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u101x\u8217x\u115x \u109x\u105x\u115x\u99x\u108x\u97x\u115x\u115x\u105x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u114x\u97x\u116x\u101x\u46x \u70x\u111x\u114x \u101x\u120x\u97x\u109x\u112x\u108x\u101x \u116x\u104x\u101x \u84x\u97x\u108x\u108x \u66x\u117x\u105x\u108x\u100x\u105x\u110x\u103x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u121x \u104x\u97x\u115x \u97x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u109x\u105x\u115x\u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u114x\u97x\u116x\u101x \u111x\u102x \u48x\u37x \u119x\u105x\u116x\u104x \u116x\u104x\u101x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u100x\u101x\u115x\u99x\u114x\u105x\u112x\u116x\u111x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u97x\u110x\u100x \u51x\u46x\u51x\u37x \u119x\u105x\u116x\u104x \u71x\u97x\u98x\u111x\u114x\u45x\u71x\u105x\u115x\u116x\u46x \u65x\u116x \u116x\u104x\u101x \u111x\u112x\u112x\u111x\u115x\u105x\u116x\u101x\u44x \u116x\u104x\u101x \u67x\u111x\u97x\u115x\u116x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u121x \u105x\u115x \u109x\u117x\u99x\u104x \u98x\u101x\u116x\u116x\u101x\u114x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u101x\u100x \u105x\u102x \u71x\u97x\u98x\u111x\u114x\u45x\u71x\u105x\u115x\u116x \u105x\u115x \u117x\u115x\u101x\u100x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u40x\u49x\u51x\u46x\u51x\u37x \u105x\u110x\u115x\u116x\u101x\u97x\u100x \u111x\u102x \u50x\u51x\u46x\u51x\u37x \u119x\u105x\u116x\u104x }{\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x\u41x\u46x}\par }
