\u110x\u115x\u117x\u112x\u101x\u114x\u118x\u105x\u115x\u101x\u100x \u116x\u101x\u120x\u116x\u117x\u114x\u101x \u115x\u101x\u103x\u109x\u101x\u110x\u116x\u97x\u116x\u105x\u111x\u110x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0     \u117x\u115x\u105x\u110x\u103x \u103x\u97x\u98x\u111x\u114x \u64257x\u108x\u116x\u101x\u114x\u115x\u44x\u8221x }{\b0\i0\strike0\f21\cf0\fs14\expnd0\expndtw0\kerning0 \u80x\u97x\u116x\u116x\u101x\u114x\u110x \u82x\u101x\u99x\u111x\u103x\u110x\u105x\u116x\u105x\u111x\u110x\u44x }{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u118x\u111x\u108x\u46x \u50x\u52x\u44x \u49x\u57x\u57x\u49x\u46x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u91x\u53x\u93x \u67x\u46x \u83x\u105x\u97x\u103x\u105x\u97x\u110x\u44x \u76x\u46x \u73x\u116x\u116x\u105x\u44x \u8220x\u82x\u97x\u112x\u105x\u100x \u98x\u105x\u111x\u108x\u111x\u103x\u105x\u99x\u97x\u108x\u108x\u121x\u45x\u105x\u110x\u115x\u112x\u105x\u114x\u101x\u100x \u115x\u99x\u101x\u110x\u101x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u45x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0     \u116x\u105x\u111x\u110x \u117x\u115x\u105x\u110x\u103x \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x \u115x\u104x\u97x\u114x\u101x\u100x \u119x\u105x\u116x\u104x \u118x\u105x\u115x\u117x\u97x\u108x \u97x\u116x\u116x\u101x\u110x\u116x\u105x\u111x\u110x\u44x\u8221x }{\b0\i0\strike0\f21\cf0\fs14\expnd0\expndtw0\kerning0 \u73x\u69x\u69x\u69x \u84x\u114x\u97x\u110x\u115x\u45x}\par {\b0\i0\strike0\f21\cf0\fs14\expnd0\expndtw0\kerning0     \u97x\u99x\u116x\u105x\u111x\u110x\u115x \u111x\u110x \u80x\u97x\u116x\u116x\u101x\u114x\u110x \u65x\u110x\u97x\u108x\u121x\u115x\u105x\u115x \u97x\u110x\u100x \u77x\u97x\u99x\u104x\u105x\u110x\u101x \u73x\u110x\u116x\u101x\u108x\u108x\u105x\u103x\u101x\u110x\u99x\u101x\u44x }{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u118x\u111x\u108x\u46x \u50x\u57x\u44x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0     \u110x\u111x\u46x \u50x\u44x \u70x\u101x\u98x \u50x\u48x\u48x\u55x\u46x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u91x\u54x\u93x \u74x\u105x\u97x\u110x\u120x\u105x\u110x \u87x\u117x\u44x \u74x\u97x\u109x\u101x\u115x \u77x\u46x \u82x\u101x\u104x\u103x\u44x \u8220x\u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x\u58x \u65x \u118x\u105x\u115x\u117x\u97x\u108x \u100x\u101x\u115x\u99x\u114x\u105x\u112x\u116x\u111x\u114x \u102x\u111x\u114x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0     \u115x\u99x\u101x\u110x\u101x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u122x\u97x\u116x\u105x\u111x\u110x\u44x\u8221x }{\b0\i0\strike0\f21\cf0\fs14\expnd0\expndtw0\kerning0 \u73x\u69x\u69x\u69x \u84x\u114x\u97x\u110x\u115x\u97x\u99x\u116x\u105x\u111x\u110x\u115x \u111x\u110x \u80x\u97x\u116x\u116x\u101x\u114x\u110x \u65x\u110x\u97x\u108x\u121x\u115x\u105x\u115x}\par {\b0\i0\strike0\f21\cf0\fs14\expnd0\expndtw0\kerning0     \u97x\u110x\u100x \u77x\u97x\u99x\u104x\u105x\u110x\u101x \u73x\u110x\u116x\u101x\u108x\u108x\u105x\u103x\u101x\u110x\u99x\u101x\u44x }{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u118x\u111x\u108x\u46x \u51x\u51x\u44x \u110x\u111x\u46x \u56x\u44x \u65x\u117x\u103x\u117x\u115x\u116x \u50x\u48x\u49x\u49x\u46x}\par }
{\pard\plain\posx934\posy5451\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u70x\u105x\u103x\u46x \u49x\u52x\u46x \u67x\u111x\u110x\u102x\u117x\u115x\u105x\u111x\u110x \u77x\u97x\u116x\u114x\u105x\u120x \u102x\u111x\u114x \u71x\u97x\u98x\u111x\u114x\u45x\u71x\u105x\u115x\u116x \u43x }{\b0\i0\strike0\f2\cf0\fs14\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u43x \u67x\u111x\u108x\u111x\u114x \u104x\u105x\u115x\u45x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u116x\u111x\u103x\u114x\u97x\u109x \u104x\u121x\u98x\u114x\u105x\u100x \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x\u46x \u49x\u45x\u67x\u111x\u97x\u115x\u116x\u59x \u50x\u45x\u70x\u111x\u114x\u101x\u115x\u116x\u59x \u51x\u45x\u72x\u105x\u103x\u104x\u119x\u97x\u121x\u59x \u52x\u45x\u77x\u111x\u117x\u110x\u116x\u97x\u105x\u110x\u59x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u53x\u45x\u84x\u97x\u108x\u108x \u66x\u117x\u105x\u108x\u100x\u105x\u110x\u103x}\par }
