{\pard\plain\posx934\posy8563\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u73x\u110x \u115x\u99x\u111x\u112x\u101x \u111x\u102x \u115x\u99x\u101x\u110x\u101x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u112x\u114x\u111x\u98x\u108x\u101x\u109x\u44x \u99x\u111x\u108x\u111x\u114x \u100x\u101x\u115x\u99x\u114x\u105x\u112x\u116x\u111x\u114x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u97x\u110x\u110x\u111x\u116x \u98x\u101x \u99x\u111x\u110x\u115x\u105x\u100x\u101x\u114x\u101x\u100x \u114x\u101x\u108x\u105x\u97x\u98x\u108x\u101x \u102x\u111x\u114x \u116x\u104x\u101x \u114x\u101x\u97x\u115x\u111x\u110x \u116x\u104x\u97x\u116x \u99x\u111x\u108x\u111x\u114x\u115x \u97x\u114x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u101x \u109x\u97x\u116x\u116x\u101x\u114x \u111x\u102x \u99x\u111x\u110x\u115x\u116x\u97x\u110x\u116x \u99x\u104x\u97x\u110x\u103x\u101x\u46x \u84x\u104x\u101x \u115x\u97x\u109x\u101x \u115x\u99x\u101x\u110x\u101x \u97x\u112x\u112x\u101x\u97x\u114x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u110x \u100x\u105x\u64256x\u101x\u114x\u101x\u110x\u116x \u99x\u111x\u108x\u111x\u114x\u115x \u100x\u101x\u112x\u101x\u110x\u100x\u105x\u110x\u103x \u111x\u110x \u116x\u104x\u101x \u116x\u105x\u109x\u101x \u111x\u102x \u116x\u104x\u101x \u100x\u97x\u121x \u111x\u114x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u115x\u101x\u97x\u115x\u111x\u110x \u102x\u111x\u114x \u101x\u120x\u97x\u109x\u112x\u108x\u101x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u65x \u108x\u111x\u116x \u111x\u102x \u112x\u97x\u112x\u101x\u114x\u115x \u115x\u116x\u105x\u108x\u108x \u111x\u64256x\u101x\u114x \u99x\u111x\u108x\u111x\u114x \u100x\u101x\u115x\u99x\u114x\u105x\u112x\u116x\u111x\u114x\u115x \u105x\u110x \u116x\u104x\u101x \u99x\u111x\u109x\u98x\u105x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u110x\u97x\u116x\u105x\u111x\u110x \u111x\u102x \u116x\u101x\u120x\u116x\u117x\u114x\u101x \u100x\u101x\u115x\u99x\u114x\u105x\u112x\u116x\u111x\u114x\u115x \u97x\u110x\u100x \u111x\u118x\u101x\u114x\u97x\u108x\u108x \u101x\u120x\u112x\u101x\u114x\u105x\u109x\u101x\u110x\u116x\u115x \u115x\u104x\u111x\u119x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u97x\u116x \u115x\u117x\u99x\u104x \u99x\u111x\u109x\u98x\u105x\u110x\u97x\u116x\u105x\u111x\u110x\u115x \u105x\u109x\u112x\u114x\u111x\u118x\u101x \u116x\u104x\u101x \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u97x\u110x\u99x\u101x \u111x\u102x \u99x\u108x\u97x\u115x\u115x\u105x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u64257x\u99x\u97x\u116x\u105x\u111x\u110x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u70x\u111x\u114x \u116x\u104x\u105x\u115x \u112x\u114x\u111x\u106x\u101x\u99x\u116x\u44x \u97x \u115x\u105x\u109x\u112x\u108x\u101x \u99x\u111x\u108x\u111x\u114x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u100x\u101x\u115x\u99x\u114x\u105x\u112x\u116x\u111x\u114x \u119x\u97x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u109x\u112x\u108x\u101x\u109x\u101x\u110x\u116x\u101x\u100x\u46x \u84x\u104x\u101x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u105x\u115x \u99x\u111x\u109x\u112x\u117x\u116x\u101x\u100x \u98x\u121x \u99x\u111x\u117x\u110x\u116x\u105x\u110x\u103x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u112x\u105x\u120x\u101x\u108x\u115x \u99x\u111x\u114x\u114x\u101x\u115x\u112x\u111x\u110x\u100x\u105x\u110x\u103x \u116x\u111x \u116x\u104x\u101x \u102x\u111x\u108x\u108x\u111x\u119x\u105x\u110x\u103x \u99x\u111x\u108x\u111x\u114x\u115x\u58x \u114x\u101x\u100x\u44x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u121x\u101x\u108x\u108x\u111x\u119x\u44x \u103x\u114x\u101x\u101x\u110x\u44x \u99x\u121x\u97x\u110x\u44x \u98x\u108x\u117x\u101x\u44x \u109x\u97x\u103x\u101x\u110x\u116x\u97x\u44x \u119x\u104x\u105x\u116x\u101x \u97x\u110x\u100x \u98x\u108x\u97x\u99x\u107x\u46x \u73x\u116x \u105x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u101x\u100x \u64257x\u114x\u115x\u116x \u116x\u104x\u114x\u111x\u117x\u103x\u104x \u99x\u111x\u110x\u118x\u101x\u114x\u116x\u105x\u110x\u103x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x \u116x\u111x \u72x\u83x\u86x \u99x\u111x\u108x\u111x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u115x\u112x\u97x\u99x\u101x \u97x\u110x\u100x \u101x\u118x\u97x\u108x\u117x\u97x\u116x\u105x\u110x\u103x \u101x\u97x\u99x\u104x \u112x\u108x\u97x\u110x\u101x \u105x\u110x \u111x\u114x\u100x\u101x\u114x \u116x\u111x \u100x\u101x\u116x\u101x\u114x\u109x\u105x\u110x\u101x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u112x\u105x\u120x\u101x\u108x\u115x \u98x\u101x\u108x\u111x\u110x\u103x\u105x\u110x\u103x \u116x\u111x \u101x\u97x\u99x\u104x \u111x\u102x \u116x\u104x\u101x \u115x\u101x\u108x\u101x\u99x\u116x\u101x\u100x \u99x\u111x\u108x\u111x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u101x\u115x\u46x \u84x\u104x\u101x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u98x\u108x\u97x\u99x\u107x \u97x\u110x\u100x \u119x\u104x\u105x\u116x\u101x \u112x\u105x\u120x\u101x\u108x\u115x \u97x\u114x\u101x \u101x\u115x\u116x\u105x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u109x\u97x\u116x\u101x\u100x \u116x\u104x\u114x\u111x\u117x\u103x\u104x \u83x\u97x\u116x\u117x\u114x\u97x\u116x\u105x\u111x\u110x \u97x\u110x\u100x \u86x\u97x\u108x\u117x\u101x \u112x\u108x\u97x\u110x\u101x\u115x\u44x \u97x\u110x\u100x \u116x\u104x\u101x \u114x\u101x\u115x\u116x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u111x\u102x \u99x\u111x\u108x\u111x\u114x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u101x\u115x \u97x\u114x\u101x \u100x\u101x\u116x\u101x\u114x\u109x\u105x\u110x\u101x\u100x \u116x\u104x\u114x\u111x\u117x\u103x\u104x \u72x\u117x\u101x \u112x\u108x\u97x\u110x\u101x\u46x \u69x\u118x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u101x\u114x\u121x \u112x\u105x\u120x\u101x\u108x \u99x\u111x\u108x\u111x\u114x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u121x \u105x\u115x \u116x\u104x\u101x\u110x \u110x\u111x\u114x\u109x\u97x\u108x\u105x\u122x\u101x\u100x \u98x\u121x \u100x\u105x\u118x\u105x\u100x\u105x\u110x\u103x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u99x\u111x\u117x\u110x\u116x \u111x\u102x \u116x\u104x\u101x \u112x\u105x\u120x\u101x\u108x\u115x \u98x\u121x \u116x\u104x\u101x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u112x\u105x\u120x\u101x\u108x \u105x\u110x \u116x\u104x\u101x \u105x\u109x\u97x\u103x\u101x\u46x \u65x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u56x\u45x\u98x\u105x\u110x \u99x\u111x\u108x\u111x\u114x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u102x\u111x\u114x\u109x\u97x\u116x\u115x \u49x\u120x\u56x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x \u40x\u115x\u101x\u101x \u64257x\u103x\u117x\u114x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u57x\u46x\u98x\u41x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u67x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u97x\u99x\u99x\u117x\u114x\u97x\u99x\u121x \u102x\u111x\u114x \u99x\u111x\u108x\u111x\u114x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x \u119x\u97x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u101x\u118x\u97x\u108x\u117x\u97x\u116x\u101x\u100x \u117x\u115x\u105x\u110x\u103x \u77x\u76x\u80x \u78x\u101x\u117x\u114x\u97x\u108x \u78x\u101x\u116x\u119x\u111x\u114x\u107x \u40x\u56x \u105x\u110x\u112x\u117x\u116x\u44x \u56x \u104x\u105x\u100x\u100x\u101x\u110x\u44x \u53x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u111x\u117x\u116x\u112x\u117x\u116x \u110x\u101x\u117x\u114x\u111x\u110x\u115x\u41x \u117x\u115x\u105x\u110x\u103x \u49x\u53x\u48x \u116x\u101x\u115x\u116x\u105x\u110x\u103x \u105x\u109x\u97x\u103x\u101x\u115x \u102x\u114x\u111x\u109x \u64257x\u118x\u101x \u100x\u105x\u64256x\u101x\u114x\u45x}\par }
{\pard\plain\posx6063\posy8350\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u70x\u105x\u103x\u46x \u49x\u48x\u46x \u67x\u111x\u110x\u102x\u117x\u115x\u105x\u111x\u110x \u109x\u97x\u116x\u114x\u105x\u120x \u102x\u111x\u114x \u67x\u111x\u108x\u111x\u114x \u72x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x\u46x \u49x\u45x\u67x\u111x\u97x\u115x\u116x\u59x}\par {\b0\i0\strike0\f6\cf0\fs14\expnd0\expndtw0\kerning0 \u50x\u45x\u70x\u111x\u114x\u101x\u115x\u116x\u59x \u51x\u45x\u72x\u105x\u103x\u104x\u119x\u97x\u121x\u59x \u52x\u45x\u77x\u111x\u117x\u110x\u116x\u97x\u105x\u110x\u59x \u53x\u45x\u84x\u97x\u108x\u108x \u66x\u117x\u105x\u108x\u100x\u105x\u110x\u103x}\par }
{\pard\plain\posx6063\posy9133\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u101x\u110x\u116x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u101x\u115x \u111x\u102x \u115x\u99x\u101x\u110x\u101x\u115x\u46x \u67x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u101x\u114x\u114x\u111x\u114x \u102x\u111x\u114x \u99x\u111x\u108x\u111x\u114x \u104x\u105x\u115x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u111x\u103x\u114x\u97x\u109x \u100x\u101x\u115x\u99x\u114x\u105x\u112x\u116x\u111x\u114x \u105x\u115x \u53x\u48x\u37x\u44x \u105x\u46x\u101x\u46x \u104x\u97x\u108x\u102x \u111x\u102x \u105x\u109x\u97x\u103x\u101x\u115x \u119x\u101x\u114x\u101x \u109x\u105x\u115x\u99x\u108x\u97x\u115x\u115x\u105x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u64257x\u101x\u100x \u40x\u115x\u101x\u101x \u64257x\u103x\u117x\u114x\u101x \u49x\u48x\u41x\u46x \u67x\u111x\u108x\u111x\u114x \u104x\u105x\u115x\u116x\u111x\u103x\u114x\u97x\u109x \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u101x\u100x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u119x\u111x\u114x\u115x\u116x \u102x\u111x\u114x \u67x\u111x\u97x\u115x\u116x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u121x \u105x\u109x\u97x\u103x\u101x\u115x \u40x\u111x\u110x\u108x\u121x \u49x\u51x\u37x \u97x\u99x\u99x\u117x\u114x\u97x\u99x\u121x\u41x\u44x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u98x\u101x\u115x\u116x \u112x\u101x\u114x\u102x\u111x\u114x\u109x\u97x\u110x\u99x\u101x \u105x\u115x \u115x\u101x\u101x\u110x \u102x\u111x\u114x \u70x\u111x\u114x\u101x\u115x\u116x \u105x\u109x\u97x\u103x\u101x\u115x \u40x\u56x\u51x\u37x \u97x\u99x\u99x\u117x\u114x\u97x\u99x\u121x\u41x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u69x\u120x\u112x\u101x\u114x\u105x\u109x\u101x\u110x\u116x\u115x \u112x\u114x\u111x\u118x\u101x\u100x \u116x\u104x\u97x\u116x \u99x\u111x\u108x\u111x\u114x \u99x\u97x\u110x\u110x\u111x\u116x \u98x\u101x \u117x\u115x\u101x\u100x \u97x\u115x \u97x \u114x\u101x\u108x\u105x\u97x\u98x\u108x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u102x\u111x\u114x \u115x\u99x\u101x\u110x\u101x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u122x\u97x\u116x\u105x\u111x\u110x \u112x\u114x\u111x\u98x\u108x\u101x\u109x\u44x \u98x\u117x\u116x \u97x\u115x \u109x\u101x\u110x\u116x\u105x\u111x\u110x\u101x\u100x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u98x\u101x\u102x\u111x\u114x\u101x\u44x \u111x\u117x\u114x \u115x\u116x\u117x\u100x\u121x \u105x\u115x \u99x\u111x\u110x\u99x\u101x\u114x\u110x\u101x\u100x \u119x\u105x\u116x\u104x \u105x\u109x\u112x\u114x\u111x\u118x\u105x\u110x\u103x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u105x\u111x\u110x \u97x\u99x\u99x\u117x\u114x\u97x\u99x\u121x \u98x\u121x \u97x\u100x\u100x\u105x\u110x\u103x \u99x\u111x\u108x\u111x\u114x \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x \u116x\u111x \u71x\u97x\u98x\u111x\u114x\u45x\u71x\u105x\u115x\u116x \u97x\u110x\u100x}\par {\b0\i0\strike0\f2\cf0\fs17\expnd0\expndtw0\kerning0 \u67x\u101x\u110x\u116x\u114x\u105x\u115x\u116x }{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x \u97x\u110x\u100x \u102x\u111x\u114x\u109x\u105x\u110x\u103x \u116x\u104x\u101x \u104x\u121x\u98x\u114x\u105x\u100x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u97x\u116x \u105x\u115x \u101x\u120x\u112x\u101x\u99x\u116x\u101x\u100x \u116x\u111x \u112x\u114x\u111x\u118x\u105x\u100x\u101x \u116x\u104x\u101x \u109x\u105x\u110x\u105x\u109x\u117x\u109x \u109x\u105x\u115x\u99x\u108x\u97x\u115x\u115x\u105x\