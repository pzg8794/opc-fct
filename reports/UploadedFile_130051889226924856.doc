{\pard\plain\posx6063\posy9757\absw5608\absh0\dxfrtext0\dfrmtxtx0\dfrmtxty0\nosnaplinegrid{\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u83x\u105x\u109x\u105x\u108x\u97x\u114x\u108x\u121x \u116x\u111x \u112x\u114x\u101x\u118x\u105x\u111x\u117x\u115x \u97x\u112x\u112x\u114x\u111x\u97x\u99x\u104x\u101x\u115x\u44x \u77x\u76x\u80x \u110x\u101x\u117x\u114x\u97x\u108x \u110x\u101x\u116x\u119x\u111x\u114x\u107x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u119x\u105x\u116x\u104x \u115x\u105x\u110x\u103x\u108x\u101x \u104x\u105x\u100x\u100x\u101x\u110x \u108x\u97x\u121x\u101x\u114x \u119x\u97x\u115x \u99x\u111x\u110x\u115x\u105x\u100x\u101x\u114x\u101x\u100x \u97x\u115x \u97x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u101x\u114x\u46x \u65x\u108x\u108x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u109x\u97x\u103x\u101x\u115x \u102x\u111x\u114x\u109x \u116x\u104x\u101x \u116x\u114x\u97x\u105x\u110x\u105x\u110x\u103x \u115x\u101x\u116x \u119x\u101x\u114x\u101x \u99x\u111x\u110x\u118x\u101x\u114x\u116x\u101x\u100x \u105x\u110x\u116x\u111x \u49x\u120x\u53x\u55x\u54x\u120x\u54x\u57x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u109x\u97x\u116x\u114x\u105x\u120x\u101x\u115x \u102x\u111x\u114x \u101x\u97x\u99x\u104x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u121x \u40x\u49x\u120x\u53x\u55x\u54x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x\u44x \u54x\u57x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u109x\u97x\u103x\u101x\u115x \u105x\u110x \u101x\u97x\u99x\u104x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u121x \u105x\u110x \u116x\u104x\u101x \u116x\u114x\u97x\u105x\u110x\u105x\u110x\u103x \u115x\u101x\u116x\u41x\u46x \u84x\u104x\u101x\u110x \u116x\u114x\u97x\u105x\u110x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u110x\u103x \u109x\u97x\u116x\u114x\u105x\u99x\u101x\u115x \u119x\u101x\u114x\u101x \u99x\u111x\u110x\u118x\u101x\u114x\u116x\u101x\u100x \u105x\u110x\u116x\u111x \u105x\u110x\u112x\u117x\u116x \u109x\u97x\u116x\u114x\u105x\u120x \u53x\u55x\u54x\u120x\u51x\u52x\u53x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u84x\u104x\u101x \u99x\u111x\u114x\u114x\u101x\u115x\u112x\u111x\u110x\u100x\u105x\u110x\u103x \u116x\u97x\u114x\u103x\u101x\u116x \u109x\u97x\u116x\u114x\u105x\u120x \u104x\u97x\u115x \u53x\u120x\u51x\u52x\u53x \u102x\u111x\u114x \u116x\u104x\u101x \u116x\u114x\u97x\u105x\u110x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u110x\u103x \u115x\u101x\u116x \u97x\u110x\u100x \u53x\u120x\u49x\u53x\u48x \u102x\u111x\u114x \u116x\u104x\u101x \u116x\u101x\u115x\u116x\u105x\u110x\u103x \u115x\u101x\u116x\u46x \u84x\u101x\u115x\u116x\u105x\u110x\u103x \u109x\u97x\u116x\u114x\u105x\u120x \u115x\u105x\u122x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u115x \u53x\u55x\u54x\u120x\u49x\u53x\u48x \u40x\u116x\u101x\u115x\u116x\u105x\u110x\u103x \u115x\u101x\u116x \u99x\u111x\u110x\u116x\u97x\u105x\u110x\u115x \u49x\u53x\u48x \u105x\u109x\u97x\u103x\u101x\u115x\u41x\u46x \u84x\u114x\u97x\u105x\u110x\u105x\u110x\u103x \u115x\u101x\u116x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u119x\u97x\u115x \u100x\u105x\u118x\u105x\u100x\u101x\u100x \u105x\u110x\u116x\u111x \u116x\u104x\u114x\u101x\u101x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u101x\u115x\u58x \u116x\u114x\u97x\u105x\u110x\u105x\u110x\u103x \u40x\u55x\u48x\u37x \u111x\u102x \u116x\u114x\u97x\u105x\u110x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u105x\u110x\u103x \u105x\u109x\u97x\u103x\u101x\u115x\u41x\u44x \u118x\u97x\u108x\u105x\u100x\u97x\u116x\u105x\u111x\u110x \u40x\u49x\u53x\u37x\u41x \u97x\u110x\u100x \u116x\u101x\u115x\u116x\u105x\u110x\u103x \u40x\u49x\u53x\u37x\u41x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u84x\u104x\u101x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u105x\u110x\u112x\u117x\u116x \u110x\u101x\u117x\u114x\u111x\u110x\u115x \u105x\u115x \u101x\u113x\u117x\u97x\u108x \u116x\u111x \u116x\u104x\u101x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u102x\u101x\u97x\u116x\u117x\u114x\u101x\u115x \u105x\u110x \u116x\u104x\u101x \u102x\u101x\u97x\u116x\u117x\u114x\u101x \u118x\u101x\u99x\u116x\u111x\u114x\u58x \u53x\u55x\u54x\u46x \u84x\u104x\u101x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u104x\u105x\u100x\u100x\u101x\u110x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u110x\u111x\u100x\u101x\u115x \u119x\u97x\u115x \u102x\u111x\u117x\u110x\u100x \u101x\u120x\u112x\u101x\u114x\u105x\u109x\u101x\u110x\u116x\u97x\u108x\u108x\u121x \u97x\u110x\u100x \u116x\u104x\u101x \u118x\u97x\u108x\u117x\u101x \u111x\u102x \u51x\u48x\u48x \u119x\u97x\u115x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u116x\u104x\u101x \u111x\u112x\u116x\u105x\u109x\u97x\u108x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u104x\u105x\u100x\u100x\u101x\u110x \u110x\u111x\u100x\u101x\u115x\u46x \u84x\u104x\u101x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u111x\u117x\u116x\u45x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u112x\u117x\u116x\u115x \u105x\u115x \u116x\u104x\u101x \u110x\u117x\u109x\u98x\u101x\u114x \u111x\u102x \u99x\u97x\u116x\u101x\u103x\u111x\u114x\u105x\u101x\u115x\u58x \u53x \u99x\u108x\u97x\u115x\u115x\u101x\u115x \u111x\u102x \u115x\u99x\u101x\u110x\u101x\u115x \u105x\u110x \u116x\u104x\u101x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0 \u100x\u97x\u116x\u97x\u115x\u101x\u116x\u46x}\par {\b0\i0\strike0\f8\cf0\fs17\expnd0\expndtw0\kerning0    \u79x\u118x\u101x\u114x\u97x\u108x\u108x \u99x\u108x\u97x\u115x\u115x\u105x\u64257x\u99x\u97x\u116x\u105x\u111x\u110x \u97x\u99x\u99x\u117x\u114x\u97x\u99x\u121x \u119x\u105x\u116x\u104x \u71x\u97x\u98x\u111x\u114x\u45x\u71x\u105x\u115x\u116x \u102x\u101x\u97x\u116x